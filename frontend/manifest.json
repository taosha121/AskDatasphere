{
  "_version": "1.58.0",
  "sap.app": {
    "id": "ask.datasphere",
    "type": "application",
    "title": "AskDatasphere",
    "applicationVersion": { "version": "0.1.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "ask.datasphere.view.Shell",
      "type": "XML",
      "id": "shell"
    },
    "dependencies": {
      "minUI5Version": "1.120",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {}
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "ask.datasphere.view",
        "controlId": "appNav",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "chat",
          "pattern": "",
          "target": "chat"
        },
        {
          "name": "chunks",
          "pattern": "chunks",
          "target": "chunks"
        },
        {
          "name": "eval",
          "pattern": "eval",
          "target": "eval"
        }
      ],
      "targets": {
        "chat": {
          "viewName": "Chat",
          "viewId": "chatView"
        },
        "chunks": {
          "viewName": "Chunks",
          "viewId": "chunksView"
        },
        "eval": {
          "viewName": "Eval",
          "viewId": "evalView"
        }
      }
    }
  }
}
